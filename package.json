{
  "name": "express-boilerplate",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "dev": "nodemon --exec 'yarn lint && node' app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "typeorm:generate": "npx typeorm-ts-node-esm migration:generate src/database/migrations/migrations -d src/models/index.js -p -o",
    "typeorm:migrate": "npx typeorm-ts-node-esm migration:run -d ./src/models/index.js"
  },
  "engines": {
    "node": ">=21.1.0"
  },
  "author": "Muhammad Farhan",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/farhannjb/express-boilerplate/issues"
  },
  "homepage": "https://github.com/farhannjb/express-boilerplate#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.17.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "eslint": "^9.10.0",
    "eslint-plugin-jest": "^28.8.3",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.7",
    "ts-node": "^10.9.2"
  }
}
