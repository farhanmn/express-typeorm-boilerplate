{
  "name": "express-typeorm-boilerplate",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "app.js",
  "jest": {
    "bail": 1,
    "verbose": true,
    "transform": {}
  },
  "scripts": {
    "start": "node app.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "dev": "nodemon --exec 'yarn lint && node' app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "typeorm:generate": "npx typeorm-ts-node-esm migration:generate src/database/migrations/migrations -d src/models/index.js -p -o",
    "typeorm:migrate": "npx typeorm-ts-node-esm migration:run -d ./src/models/index.js"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#controllers/*": "./src/controllers/*",
    "#database/*": "./src/database/*",
    "#helper/*": "./src/helper/*",
    "#middlewares/*": "./src/middlewares/*",
    "#models/*": "./src/models/*",
    "#public/*": "./public/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*",
    "#tests/*": "./src/tests/*"
  },
  "engines": {
    "node": ">=21.1.0"
  },
  "author": "Muhammad Farhan",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/farhanmn/express-typeorm-boilerplate/issues"
  },
  "homepage": "https://github.com/farhanmn/express-typeorm-boilerplate#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-plugin-jest": "^29.0.1",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2"
  }
}
